{
  "name": "dream",
  "version": "0.1.0",
  "description": "Dream - Educational Scheduling & Financial Settlement System",
  "private": true,
  "workspaces": [
    "dream-core",
    "dream-backend",
    "dream-worker",
    "dream-frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "dev:backend": "npm run dev --workspace=@topeetop/dream-backend",
    "dev:frontend": "npm run dev --workspace=@topeetop/dream-frontend",
    "dev:worker": "npm run dev --workspace=@topeetop/dream-worker",
    "build:core": "npm run build --workspace=@topeetop/dream-core"
  },
  "keywords": [
    "scheduling",
    "education",
    "settlement",
    "fastify",
    "vue3"
  ],
  "author": "Lyon <hi@topee.top>",
  "license": "ISC",
  "dependencies": {
    "@topeetop/auth-core": "^0.9.114",
    "@topeetop/env-secure-conf": "^0.9.110",
    "@topeetop/notification-client": "^0.9.110",
    "@topeetop/security-core": "^0.9.111",
    "@topeetop/shared-core": "^0.9.111",
    "pg": "^8.11.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "esbuild": "^0.24.0",
    "javascript-obfuscator": "^5.3.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
