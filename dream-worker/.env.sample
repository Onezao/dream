# Dream System Environment Configuration Sample
# Copy this file to .env.dev and fill in your actual decrypted or local credentials.
# NOTE: Do NOT place real production secrets or private keys in this file.

PORT=8072
APP_TIMEZONE=Asia/Shanghai
SECRET_MASTER_KEY="your-16-char-master-key"

ENABLE_BACKEND_ACCESS_LOG=true

# Cache Configuration (CACHE_DRIVER: memory / redis / db)
CACHE_DRIVER=redis
REDIS_URL="redis://localhost:6379"

# Service Base URLs
AUTH_API_BASE_URL="http://localhost:8080/auth/v1"

# ----- JWT Configuration (Two-Slot Rotation) -----
# Current active key version
JWT_CURRENT_VERSION="v2"
# Public key for validation (PEM format, newline replaced with \n)
JWT_CURRENT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"
# Private key for signing (Encrypted using SECRET_MASTER_KEY)
JWT_CURRENT_PRIVATE_KEY_CIPHER="encrypted-private-key-base64"

# Previous key version (for smooth zero-downtime key rotation)
JWT_PREVIOUS_VERSION="v1"
JWT_PREVIOUS_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"

# ----- Notification (Email & SMS) Configuration -----
EMAIL_PROVIDER="brevo"
EMAIL_API_KEY_CIPHER="encrypted-email-api-key-base64"
EMAIL_SENDER_EMAIL="noreply@topee.top"
EMAIL_SENDER_NAME="Dream System"
SMS_PROVIDER="aliyun"
SMS_ACCESS_KEY_ID="your-sms-access-key-id"
SMS_ACCESS_KEY_SECRET_CIPHER="encrypted-sms-secret-base64"
SMS_SIGN_NAME="验证码"
SMS_TEMPLATE_CODE="100001"

# ----- S3/R2 Cloudflare Storage Configuration -----
S3_BUCKET="your-bucket-name"
S3_REGION="auto"
S3_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com/"
# Access Key ID (Encrypted)
S3_ACCESS_KEY_ID_CIPHER="encrypted-access-key-id-base64"
# Secret Access Key (Encrypted)
S3_SECRET_ACCESS_KEY_CIPHER="encrypted-secret-access-key-base64"
S3_PUBLIC_DOMAIN="https://st.example.com"

# ----- Database Configuration (PostgreSQL Single Schema: dream) -----
# Database Connection String (Encrypted)
DB_URL_CIPHER="encrypted-db-url-base64"
# Or plain text for local development (NOT RECOMMENDED for production)
# DB_URL="postgresql://user:password@localhost:5432/dream_dev"
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MILLIS=20000
DB_USE_SSL=false

# Internal API Secret for cross-service communication
INTERNAL_API_SECRET="your-internal-api-secret-here"

# Task Relay Configuration
TASK_RELAY_ENDPOINT="https://task-relay.topee.top"
TASK_RELAY_TOKEN="your-task-relay-token"
TASK_RELAY_QUEUE_NAME="dream-queue-dev"
USE_REAL_TASK_RELAY=false
